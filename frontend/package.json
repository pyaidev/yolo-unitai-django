{
  "name": "unitai",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "1.21.1",
    "bootstrap": "4.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.6",
    "react-toastify": "9.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  },
  "scripts": {
    "start": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "test": "node --test tests/*.test.cjs",
    "test:security": "npm test && npm audit --audit-level=low",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
